<?xml version="1.0"?>
<launch>
  <!-- Launch arguments -->
  <arg name="mqtt_broker" default="localhost"
       description="MQTT broker hostname or IP address" />
  <arg name="mqtt_port" default="1883"
       description="MQTT broker port" />
  <arg name="mqtt_topic" default="esp32/imu/data"
       description="MQTT topic for ESP32 IMU data" />
  <arg name="database_path" default="esp32_imu_position.db"
       description="Path to SQLite database file" />
  <arg name="use_rviz" default="true"
       description="Launch RVIZ2 for visualization" />
  <arg name="initial_x" default="0.0"
       description="Initial X position (meters)" />
  <arg name="initial_y" default="0.0"
       description="Initial Y position (meters)" />

  <!-- Paths -->
  <let name="pkg_share" value="$(find-pkg-share odometry_pkg)" />
  <let name="rviz_config" value="$(var pkg_share)/rviz/odometry_visualization.rviz" />
  <let name="params_file" value="$(var pkg_share)/config/robot_params.yaml" />

  <!-- Robot State Publisher (URDF) -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen"
        args="--ros-args --params-file $(var params_file)">
  </node>

  <!-- MQTT IMU Bridge (lifecycle node) -->
  <node pkg="imu_sensor_pkg" exec="mqtt_imu_bridge" name="mqtt_imu_bridge" output="screen">
    <param name="mqtt_broker" value="$(var mqtt_broker)" />
    <param name="mqtt_port" value="$(var mqtt_port)" />
    <param name="mqtt_topic" value="$(var mqtt_topic)" />
  </node>

  <!-- Position/Velocity Approximator -->
  <node pkg="odometry_pkg" exec="position_velocity_approximator" name="position_velocity_approximator" output="screen"
        args="--ros-args --params-file $(var params_file)">
    <param name="initial_x" value="$(var initial_x)" />
    <param name="initial_y" value="$(var initial_y)" />
    <param name="initial_alpha" value="0.0" />
    <param name="enable_drift_correction" value="true" />
    <param name="static_accel_threshold" value="1.5" />
    <param name="static_gyro_threshold" value="0.5" />
    <param name="velocity_damping" value="0.85" />
    <param name="gravity_z" value="9.81" />
    <param name="zupt_count_threshold" value="25" />
  </node>

  <!-- Database Handler -->
  <node pkg="odometry_pkg" exec="database_handler" name="database_handler" output="screen">
    <param name="database_path" value="$(var database_path)" />
    <param name="subscribe_imu" value="true" />
    <param name="subscribe_acceleration" value="false" />
    <param name="subscribe_velocity" value="true" />
    <param name="subscribe_position" value="true" />
  </node>

  <!-- Position Visualizer -->
  <node pkg="odometry_pkg" exec="position_visualizer.py" name="position_visualizer" output="screen">
    <param name="use_mesh" value="true" />
    <param name="mesh_scale" value="0.001" />
  </node>

  <!-- RVIZ2 (conditional) -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(var rviz_config)" if="$(var use_rviz)" />

  <!-- Lifecycle transitions for mqtt_imu_bridge -->
  <!-- Lifecycle transitions omitted in XML to avoid launcher errors.
       Configure/activate manually:
       ros2 lifecycle set /mqtt_imu_bridge configure
       ros2 lifecycle set /mqtt_imu_bridge activate -->
</launch>
