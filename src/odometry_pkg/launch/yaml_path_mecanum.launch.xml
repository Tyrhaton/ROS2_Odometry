<?xml version="1.0"?>
<launch>
  <!--
    YAML Path Simulator Launch File - Mecanum Mode
    
    Launch the YAML path simulator for mecanum wheel (velocity-based) simulation.
    
    Usage:
      ros2 launch odometry_pkg yaml_path_mecanum.launch.xml \
        path_file:=config/paths/mecanum_velocity_path.yaml
  -->
  
  <!-- Arguments -->
  <arg name="path_file" default="config/paths/mecanum_velocity_path.yaml"
       description="YAML path file relative to package share or absolute path" />
  <arg name="use_rviz" default="true"
       description="Launch RVIZ2 for visualization" />
  <arg name="database_path" default="yaml_path_mecanum.db"
       description="SQLite database path for logging" />
  <arg name="loop" default="false"
       description="Whether to loop the path" />
  
  <!-- Robot parameters -->
  <arg name="wheel_radius" default="0.05"
       description="Wheel radius in meters" />
  <arg name="wheel_base_x" default="0.30"
       description="Distance between front and rear wheels" />
  <arg name="wheel_base_y" default="0.25"
       description="Distance between left and right wheels" />
  <arg name="initial_x" default="0.0"
       description="Initial X position (meters)" />
  <arg name="initial_y" default="0.0"
       description="Initial Y position (meters)" />

  <let name="pkg_share" value="$(find-pkg-share odometry_pkg)" />
  <let name="rviz_config" value="$(var pkg_share)/rviz/odometry_visualization.rviz" />
  <let name="urdf_path" value="$(var pkg_share)/urdf/mecanum_robot.urdf" />

  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" 
        name="robot_state_publisher" output="screen">
    <param name="robot_description" value="'$(command 'cat $(var urdf_path)')'" />
  </node>

  <!-- YAML Path Simulator for Mecanum -->
  <node pkg="odometry_pkg" exec="yaml_path_simulator.py" 
        name="yaml_path_simulator" output="screen">
    <param name="path_file" value="$(var pkg_share)/$(var path_file)" />
    <param name="sensor_type" value="mecanum" />
    <param name="initial_x" value="$(var initial_x)" />
    <param name="initial_y" value="$(var initial_y)" />
    <param name="wheel_radius" value="$(var wheel_radius)" />
    <param name="wheel_base_x" value="$(var wheel_base_x)" />
    <param name="wheel_base_y" value="$(var wheel_base_y)" />
    <param name="loop" value="$(var loop)" />
  </node>

  <!-- Mecanum Position Approximator -->
  <node pkg="odometry_pkg" exec="mecanum_position_approximator" 
        name="mecanum_position_approximator" output="screen">
    <param name="initial_x" value="$(var initial_x)" />
    <param name="initial_y" value="$(var initial_y)" />
    <param name="initial_alpha" value="0.0" />
    <param name="wheel_radius" value="$(var wheel_radius)" />
    <param name="wheel_base_x" value="$(var wheel_base_x)" />
    <param name="wheel_base_y" value="$(var wheel_base_y)" />
  </node>

  <!-- Database handler -->
  <node pkg="odometry_pkg" exec="database_handler" 
        name="database_handler" output="screen">
    <param name="database_path" value="$(var database_path)" />
    <param name="subscribe_imu" value="false" />
    <param name="subscribe_acceleration" value="false" />
    <param name="subscribe_velocity" value="true" />
    <param name="subscribe_position" value="true" />
    <remap from="/odometry/velocity_from_accel" to="/odometry/velocity_from_wheels" />
    <remap from="/odometry/position_from_accel" to="/odometry/position_from_wheels" />
  </node>

  <!-- Position visualizer -->
  <node pkg="odometry_pkg" exec="position_visualizer.py" 
        name="position_visualizer" output="screen">
    <param name="use_mesh" value="true" />
    <param name="mesh_scale" value="0.001" />
    <remap from="/odometry/position_from_accel" to="/odometry/position_from_wheels" />
  </node>

  <!-- RVIZ2 visualization -->
  <timer period="0.5" if="$(var use_rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(var rviz_config)" />
  </timer>
</launch>
