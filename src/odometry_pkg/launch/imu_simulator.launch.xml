<launch>
  <!-- Arguments -->
  <arg name="publish_rate_hz" default="50"
       description="IMU data publishing rate in Hz" />
  <arg name="initial_position_x" default="0.0"
       description="Initial X position in meters" />
  <arg name="initial_position_y" default="0.0"
       description="Initial Y position in meters" />
  <arg name="initial_alpha" default="0.0"
       description="Initial orientation in radians" />
  <arg name="noise_std" default="0.0005"
       description="Standard deviation of acceleration noise in m/s² (reduced for cleaner sim)" />
  <arg name="cycle_time" default="30.0"
       description="Time for one complete cycle in seconds" />
  <arg name="wheel_radius" default="0.05"
       description="Wheel radius in meters" />
  <arg name="wheel_base_x" default="0.30"
       description="Distance between front and rear wheels (lx)" />
  <arg name="wheel_base_y" default="0.25"
       description="Distance between left and right wheels (ly)" />
  <arg name="use_rviz" default="true"
       description="Launch RVIZ2 for visualization" />
  <arg name="database_path" default="imu_test.db"
       description="Path to SQLite database file" />

  <!-- Motion parameters (Simple mode) -->
  <arg name="forward_velocity" default="0.3"
       description="Forward velocity in m/s" />
  <arg name="forward_duration" default="5.0"
       description="Duration of forward driving in seconds" />
  <arg name="rotation_angle" default="1.5708"
       description="Rotation angle in radians (default: 90 degrees = pi/2)" />
  <arg name="transition_time" default="0.5"
       description="Time for acceleration/deceleration transitions" />

  <!-- Custom path parameters (overrides simple mode if provided) -->
  <arg name="path_times" default="[]"
       description="Array of time points for each phase" />
  <arg name="path_velocities_x" default="[]"
       description="Array of X velocities for each phase" />
  <arg name="path_velocities_y" default="[]"
       description="Array of Y velocities for each phase" />
  <arg name="path_rotations" default="[]"
       description="Array of angular velocities for each phase" />

  <let name="pkg_share" value="$(find-pkg-share odometry_pkg)" />
  <let name="rviz_config" value="$(var pkg_share)/rviz/odometry_visualization.rviz" />
  <let name="urdf_path" value="$(var pkg_share)/urdf/mecanum_robot.urdf" />

  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="'$(command 'cat $(var urdf_path)')'" />
  </node>

  <!-- IMU Simulator - New clean state machine implementation -->
  <node pkg="odometry_pkg" exec="imu_simulator.py" name="imu_simulator" output="screen">
    <param name="publish_rate_hz" value="$(var publish_rate_hz)" />
    <param name="initial_position_x" value="$(var initial_position_x)" />
    <param name="initial_position_y" value="$(var initial_position_y)" />
    <param name="initial_alpha" value="$(var initial_alpha)" />
    <param name="noise_std" value="$(var noise_std)" />
    <param name="cycle_time" value="$(var cycle_time)" />
    <param name="wheel_radius" value="$(var wheel_radius)" />
    <param name="wheel_base_x" value="$(var wheel_base_x)" />
    <param name="wheel_base_y" value="$(var wheel_base_y)" />
    <!-- Motion parameters (Simple mode) -->
    <param name="forward_velocity" value="$(var forward_velocity)" />
    <param name="forward_duration" value="$(var forward_duration)" />
    <param name="rotation_angle" value="$(var rotation_angle)" />
    <param name="transition_time" value="$(var transition_time)" />
    <!-- Custom path parameters -->
    <param name="path_times" value="$(var path_times)" />
    <param name="path_velocities_x" value="$(var path_velocities_x)" />
    <param name="path_velocities_y" value="$(var path_velocities_y)" />
    <param name="path_rotations" value="$(var path_rotations)" />
  </node>

  <!-- Position and velocity approximator with trapezoidal integration -->
  <node pkg="odometry_pkg" exec="position_velocity_approximator" name="position_velocity_approximator" output="screen">
    <param name="initial_x" value="$(var initial_position_x)" />
    <param name="initial_y" value="$(var initial_position_y)" />
    <param name="initial_alpha" value="$(var initial_alpha)" />
    <param name="wheel_base_x" value="$(var wheel_base_x)" />
    <param name="wheel_base_y" value="$(var wheel_base_y)" />
    <!-- ZUPT Drift Correction - Tuned for simulation with noise -->
    <!-- Threshold must be above motion noise (~0.02) but detect exact zero -->
    <param name="static_accel_threshold" value="0.005" />
    <!-- Very low gyro threshold to detect zero rotation -->
    <param name="static_gyro_threshold" value="0.005" />
    <!-- Strong damping when approaching static: 0.5 = 50% reduction per frame -->
    <param name="velocity_damping" value="0.5" />
    <!-- Instant ZUPT: 3 frames = 0.06 seconds @ 50Hz -->
    <param name="zupt_count_threshold" value="3" />
    <!-- Enable drift correction -->
    <param name="enable_drift_correction" value="true" />
  </node>

  <!-- Database handler -->
  <node pkg="odometry_pkg" exec="database_handler" name="database_handler" output="screen">
    <param name="database_path" value="$(var database_path)" />
    <param name="subscribe_imu" value="true" />
    <param name="subscribe_acceleration" value="true" />
    <param name="subscribe_velocity" value="true" />
    <param name="subscribe_position" value="true" />
  </node>

  <!-- Position visualizer for RVIZ -->
  <node pkg="odometry_pkg" exec="position_visualizer.py" name="position_visualizer" output="screen">
    <remap from="/odometry/position_from_accel" to="/odometry/position_from_accel" />
    <param name="use_mesh" value="true" />
    <param name="mesh_scale" value="0.001" />
  </node>

  <!-- RVIZ2 visualization -->
  <timer period="0.2" if="$(var use_rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(var rviz_config)" />
  </timer>
</launch>
