<?xml version="1.0"?>
<launch>
  <!--
    YAML Path Simulator Launch File
    
    Launch the YAML path simulator with a custom path file for either
    IMU (acceleration-based) or Mecanum wheel (velocity-based) simulation.
    
    Usage:
      # For IMU with constant acceleration path:
      ros2 launch odometry_pkg yaml_path_simulator.launch.xml \
        path_file:=config/paths/imu_constant_accel.yaml \
        sensor_type:=imu
      
      # For mecanum wheels:
      ros2 launch odometry_pkg yaml_path_simulator.launch.xml \
        path_file:=config/paths/mecanum_velocity_path.yaml \
        sensor_type:=mecanum
  -->
  
  <!-- Arguments -->
  <arg name="path_file" default="config/paths/imu_constant_accel.yaml"
       description="YAML path file relative to package share or absolute path" />
  <arg name="sensor_type" default="imu"
       description="Sensor type: 'imu' (acceleration) or 'mecanum' (velocity)" />
  <arg name="use_rviz" default="true"
       description="Launch RVIZ2 for visualization" />
  <arg name="database_path" default="yaml_path_test.db"
       description="SQLite database path for logging" />
  <arg name="loop" default="false"
       description="Whether to loop the path" />
  <arg name="drift_correction" default="false"
       description="Enable drift correction in the approximator (true/false)" />
  <arg name="interval" default="-1"
       description="Sample interval in milliseconds (overrides YAML sample_rate_hz, -1 = use YAML)" />
  <arg name="decimalen" default="6"
       description="Decimal precision for acceleration values (2 = trappetjes, 6 = smooth)" />
  
  <!-- Robot parameters -->
  <arg name="wheel_radius" default="0.05"
       description="Wheel radius in meters" />
  <arg name="wheel_base_x" default="0.30"
       description="Distance between front and rear wheels" />
  <arg name="wheel_base_y" default="0.25"
       description="Distance between left and right wheels" />
  <arg name="initial_x" default="0.0"
       description="Initial X position (meters)" />
  <arg name="initial_y" default="0.0"
       description="Initial Y position (meters)" />

  <let name="pkg_share" value="$(find-pkg-share odometry_pkg)" />
  <let name="rviz_config" value="$(var pkg_share)/rviz/odometry_visualization.rviz" />
  <let name="urdf_path" value="$(var pkg_share)/urdf/mecanum_robot.urdf" />

  <!-- Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" 
        name="robot_state_publisher" output="screen">
    <param name="robot_description" value="'$(command 'cat $(var urdf_path)')'" />
  </node>

  <!-- IMU Simulator (C++) -->
  <node pkg="odometry_pkg" exec="imu_simulator" 
        name="imu_simulator" output="screen">
    <param name="path_file" value="$(var pkg_share)/$(var path_file)" />
    <param name="initial_x" value="$(var initial_x)" />
    <param name="initial_y" value="$(var initial_y)" />
    <param name="loop" value="$(var loop)" />
    <param name="interval" value="$(var interval)" />
    <param name="decimalen" value="$(var decimalen)" />
  </node>

  <!-- Position/Velocity Approximator - Always use position_velocity_approximator for IMU -->
  <node pkg="odometry_pkg" exec="position_velocity_approximator" 
        name="position_velocity_approximator" output="screen">
    <param name="robot_description" value="'$(command 'cat $(var urdf_path)')'" />
    <param name="initial_x" value="$(var initial_x)" />
    <param name="initial_y" value="$(var initial_y)" />
    <param name="initial_alpha" value="0.0" />
    <param name="wheel_radius" value="$(var wheel_radius)" />
    <param name="wheel_base_x" value="$(var wheel_base_x)" />
    <param name="wheel_base_y" value="$(var wheel_base_y)" />
    <!-- Drift correction - controllable via launch argument -->
    <param name="enable_drift_correction" value="$(var drift_correction)" />
    <!-- Use lower threshold so 0.1 m/s² acceleration is detected as motion -->
    <param name="static_accel_threshold" value="0.02" />
    <param name="static_gyro_threshold" value="0.01" />
    <param name="velocity_damping" value="0.8" />
    <!-- Wait longer before ZUPT activates (50 frames = 1 second @ 50Hz) -->
    <param name="zupt_count_threshold" value="50" />
  </node>

  <!-- Database handler -->
  <node pkg="odometry_pkg" exec="database_handler" 
        name="database_handler" output="screen">
    <param name="database_path" value="$(var database_path)" />
    <param name="subscribe_imu" value="true" />
    <param name="subscribe_acceleration" value="true" />
    <param name="subscribe_velocity" value="true" />
    <param name="subscribe_position" value="true" />
    <remap from="/odometry/velocity_from_accel" to="/odometry/velocity_from_wheels" />
    <remap from="/odometry/position_from_accel" to="/odometry/position_from_wheels" />
  </node>

  <!-- Position visualizer (C++) -->
  <node pkg="odometry_pkg" exec="position_visualizer" 
        name="position_visualizer" output="screen">
    <param name="use_mesh" value="true" />
    <param name="mesh_scale" value="0.001" />
    <remap from="/odometry/position_from_accel" to="/odometry/position_from_wheels" />
  </node>

  <!-- RVIZ2 visualization -->
  <timer period="0.5" if="$(var use_rviz)">
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
          args="-d $(var rviz_config)" />
  </timer>
</launch>
